# Neural Link — environment configuration
# Copy to .env and fill in your own values. .env is gitignored.

# Required: your OpenRouter API key (used for chat completions).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the chat model (any OpenRouter-compatible model id).
# IMPORTANT: your OpenRouter account is in "Only Allow" guardrail mode, so the
# model MUST be on your Allowed Models list (e.g. nvidia/nemotron-3-nano-30b-a3b:free,
# poolside/laguna-s-2.1:free). google/gemini-2.5-flash is BLOCKED by your allow-list.
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Optional: voice synthesis model (OpenRouter audio / Fish Audio).
# Defaults to the free Fish Audio model if unset.
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
# Male voice (Jarvis) reference_id — Fish Audio selects voices by this UUID.
OPENROUTER_TTS_VOICE=14129c3e320149449d6bada6862f7338

# Optional: public site URL sent to OpenRouter as HTTP-Referer.
SITE_URL=http://localhost:5000

# Optional: PostgreSQL connection string.
# NOTE: the app does NOT require a database at runtime — the DB package
# is provided for future use. Leave unset unless you provision Postgres.
DATABASE_URL=
